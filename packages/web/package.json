{
  "name": "@bokrah/design-system",
  "version": "0.2.0",
  "description": "Bokrah design tokens and accessible framework-independent web styles",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./icons/*": "./dist/icons/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahfoud-Sa/bokrah-design-system.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "license": "UNLICENSED"
}
